---
import Base from '../layouts/Base.astro';
const problems=[['Onboarding that takes days','Manual checks make genuine customers give up and delay the help people came for.'],['Staff time slipping away','Repeat reviews and duplicate checks quietly drain hours and budgets.'],['Private files in the wrong place','Copies of IDs and medical records in shared folders put people and reputations at risk.'],['Records that never quite match','Separate databases create duplicate profiles and lost follow-ups.']];
const helps=[['Verified without paperwork','A few details and a gentle presence check. Done in under two seconds.'],['Privacy that protects dignity','We confirm who people are without leaving raw files exposed.'],['Automatic, with people in charge','Routine approvals are instant. Rare cases go to a clear review screen.'],['Fits what you already use','Connects to your portals, apps, and databases. No rebuild needed.']];
const sectors=[['healthcare','Healthcare','Care that starts without a queue.'],['finance','Finance','Accounts opened in moments.'],['pensions','Pensions','Dignity for every member.'],['hiring','Enterprise hiring','Great hires, day one.']];
const rows=[['f1','Verified without paperwork','Your people share a few details and complete a gentle presence check. Done in under two seconds.','/how-it-works'],['f2','Privacy that protects dignity','We confirm who people are without leaving raw personal or medical files in vulnerable storage.','/security'],['f3','Automatic, with people in charge','Routine approvals are instant. Rare cases reach a clear review screen with the key facts highlighted.','/human-review'],['f4','Fits what you already use','Connect to your portals, apps, and databases and keep every record in step. No rebuild needed.','/integrations']];
---
<Base title="Verify people in seconds">
<section class="hero"><div class="wrap two"><div><p class="eyebrow">Trusted by design</p><h1>Welcome people in seconds, not days.</h1><p class="lead">Banku Network helps healthcare, finance, pension, and hiring teams confirm who someone is, quickly, kindly, and without exposing their private files.</p><p><a class="btn" href="/contact">Talk with our team</a> <a class="btn ghost" href="/how-it-works">See how it works</a></p></div>
<img class="art" src="/img/hero.svg" width="520" height="420" alt="A phone confirming a person is verified in under two seconds" fetchpriority="high"></div></section>
<section class="strip"><div class="wrap"><span>Healthcare</span><span>Finance</span><span>Pensions</span><span>Enterprise hiring</span></div></section>
<section class="wrap pad"><p class="eyebrow dk">Made for the people you serve</p><h2>One calm welcome for every sector.</h2><div class="grid">{sectors.map(([s,t,d])=><a class="card tcard reveal" href={'/'+s}><img src={'/img/'+s+'.svg'} width="480" height="360" alt="" loading="lazy" decoding="async"><h3>{t}</h3><p>{d}</p></a>)}</div></section>
<section class="soft"><div class="wrap pad"><p class="eyebrow dk">What slows you down today</p><h2>Good people deserve a better first step.</h2><div class="grid">{problems.map(([t,d],n)=><article class="card w reveal"><span class="num">{n+1}</span><h3>{t}</h3><p>{d}</p></article>)}</div></div></section>
{rows.map(([f,t,d,h],n)=><section class="wrap row reveal" class:list={[{flip:n%2}]}><div><p class="eyebrow dk">How we help</p><h2>{t}</h2><p class="lead dkl">{d}</p><a class="btn" href={h}>Learn more</a></div><img class="art" src={'/img/'+f+'.svg'} width="480" height="360" alt="" loading="lazy" decoding="async"></section>)}
<section class="wrap pad stats"><div class="reveal"><b>&lt; 2s</b><p>to confirm someone is eligible</p></div><div class="reveal"><b>0</b><p>raw personal files left exposed</p></div><div class="reveal"><b>1</b><p>clear screen for human sign-off</p></div></section>
<section class="wrap"><div class="cta reveal"><h2>Make the first moment a good one.</h2><p>Tell us what slows your team down. We will show you a calmer way.</p><a class="btn" href="/contact">Talk with our team</a></div></section>
</Base>
